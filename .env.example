# Required
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=YOUR_APPLICATION_CLIENT_ID_HERE

# Optional AI providers. Only the provider selected in its module config is used.
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Optional database providers. URLs can instead live in the module/root config.
MYSQL_URL=
DATABASE_URL=
MONGODB_URI=
REDIS_URL=redis://127.0.0.1:6379

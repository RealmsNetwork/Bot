{
  "name": "realms-bot",
  "version": "0.1.0",
  "description": "RealmsNetwork production-grade modular Discord bot framework",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "deploy": "node deploy-commands.js",
    "build:panel": "tailwindcss -i modules/dashboard/src/input.css -o modules/dashboard/public/admin.css --minify",
    "advanced:sync": "node tools/sync-advanced.js",
    "check": "node tools/qc.js",
    "syntax": "node tools/qc.js --syntax",
    "health": "node tools/qc.js --health",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "discord",
    "bot",
    "modular",
    "sharding",
    "automation",
    "moderation",
    "realmsnetwork",
    "ai",
    "sqlite",
    "mysql",
    "postgres",
    "mongodb",
    "redis",
    "admin-panel"
  ],
  "author": "THEMPGUY",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RealmsNetwork/Bot"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "js-yaml": "4.1.0",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "nodemon": "3.1.14"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "better-sqlite3": true,
    "@discordjs/opus": true
  }
}
